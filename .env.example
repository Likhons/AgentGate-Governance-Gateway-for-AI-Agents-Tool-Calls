# AgentGate environment template (Requirement C2).
# Copy to .env (git-ignored) and replace every change_me value before the first start:
#   cp .env.example .env
# docker compose reads .env automatically; `./gradlew bootRun` (dev profile) imports it too.
# Postgres keeps the password from its FIRST start in the postgres_data volume; after changing
# POSTGRES_PASSWORD run `docker compose down -v` once (this deletes local data).

POSTGRES_DB=agentgate
POSTGRES_USER=agentgate
POSTGRES_PASSWORD=change_me_postgres_password

# HMAC-SHA256 keys: at least 32 characters each (validated at startup)
AGENTGATE_SECURITY_JWT_SECRET=change_me_32_byte_minimum_hmac_signing_key_2026
AGENTGATE_AUDIT_HMAC_SECRET=change_me_audit_chain_secret_key_2026

# Operator console / admin API accounts: passwords must be at least 8 characters
AGENTGATE_ADMIN_USERNAME=user
AGENTGATE_ADMIN_PASSWORD=change_me_admin_password
AGENTGATE_APPROVER_USERNAME=approver
AGENTGATE_APPROVER_PASSWORD=change_me_approver_password
AGENTGATE_AUDITOR_USERNAME=auditor
AGENTGATE_AUDITOR_PASSWORD=change_me_auditor_password

# Optional: fallback approver webhook for high-risk tools registered without an approvalWebhookUrl (FR4)
AGENTGATE_APPROVAL_WEBHOOK_URL=

# Optional: operations webhook that receives limit-breach alerts (FR6)
AGENTGATE_LIMIT_ALERT_WEBHOOK_URL=
